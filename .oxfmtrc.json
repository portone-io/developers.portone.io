{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/tailwind.css"
  },
  "sortImports": {
    "customGroups": [
      {
        "groupName": "node-builtin",
        "elementNamePattern": [
          "node:*",
          "node:*/**"
        ]
      }
    ],
    "groups": [
      "side_effect",
      "node-builtin",
      [
        "builtin",
        "external"
      ],
      [
        "internal",
        "subpath"
      ],
      "parent",
      {
        "newlinesBetween": false
      },
      [
        "sibling",
        "index"
      ]
    ]
  },
  "ignorePatterns": [
    "src/routes/(root)/docs/**",
    "**/*.{md,mdx,json,jsonc,json5,yaml,yml,css,scss,less,html,vue,graphql,toml,code-snippets}"
  ]
}
